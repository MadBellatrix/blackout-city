# 1. Basis-Serverkonfiguration
PORT=5000
NODE_ENV=development

# 2. Datenbank (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/blackout-city?retryWrites=true&w=majority

# 3. Authentifizierung & JWT
JWT_SECRET=super_secret_blackout_city_key_hier_aendern

# 4. E-Mail-Service (Resend)
RESEND_API_KEY=re_123456789
EMAIL_FROM=Blackout-City <noreply@blackout-city.de>
CLIENT_URL=http://localhost:5173

# 5. Discord-Bot & Webhook-Integration
DISCORD_BOT_TOKEN=hier_dein_kopiertes_bot_token
DISCORD_CLIENT_ID=hier_deine_kopierte_application_id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/hier_deine_webhook_id_und_token
